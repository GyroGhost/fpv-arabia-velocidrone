# Bot token from the Discord Developer Portal
DISCORD_TOKEN=
# Channel where the daily track is posted
CHANNEL_ID=
# Server id, makes slash commands appear right away (optional)
GUILD_ID=0
# Hour the daily track changes, in TIMEZONE
START_HOUR=20
TIMEZONE=Asia/Kuwait
# How often the leaderboard is checked
POLL_MINUTES=10
# Only pick tracks with at most this many leaderboard rows (the site shows 200)
MAX_ENTRIES=180
# Days before a track can be picked again
NO_REPEAT_DAYS=90
# Role given to the daily winner (0 = off)
WINNER_ROLE_ID=0
# Where the bot keeps its state. On Railway, mount a volume at /data and use /data/state.json
DATA_FILE=data/state.json
